# Velauto Backend - Environment Configuration Example
#
# 📝 KULLANIM TALIMATLARI:
# 1. Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# 2. .env dosyasında değerleri kendi ortamınıza göre düzenleyin
# 3. .env dosyasını ASLA git'e commit etmeyin (.gitignore'a eklidir)
# 4. Yeni geliştirici eklendiğinde bu dosyayı referans olarak verin
#
# ⚠️ UYARI:
# - Bu dosya GIT'e COMMIT EDILIR (referans olarak)
# - Gerçek .env dosyası (.gitignore'da) GIT'e COMMIT EDILMEZ

# ============================================================================
# APPLICATION - Uygulama Ayarları
# ============================================================================
APP_NAME=Velauto
APP_ENV=development
APP_DEBUG=true
APP_PORT=8090

# ============================================================================
# DATABASE - Veritabanı Ayarları
# MySQL Veritabanı Bağlantısı
# Proje MySQL kullanmaktadır!
# ============================================================================
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://localhost:3306/velauto?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=123
DB_POOL_SIZE=10
DB_POOL_MAX_LIFETIME=1800000

# ============================================================================
# SECURITY - Güvenlik Ayarları
# JWT Konfigürasyonu
# JWT_EXPIRATION: 3600000ms = 1 Saat
# JWT_REFRESH_EXPIRATION: 86400000ms = 24 Saat
# ============================================================================
JWT_SECRET=velAutoSecretKeyForJwtSecurityVelAutoSecretKeyForJwtSecurity
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ============================================================================
# EMAIL - E-Mail Ayarları
# ============================================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@velauto.com
MAIL_FROM_NAME=Velauto

# ============================================================================
# FILE UPLOAD - Dosya Yükleme Ayarları
# ============================================================================
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# ============================================================================
# LOGGING - Log Ayarları
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/application.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=10

# ============================================================================
# EXTERNAL SERVICES - Dış Hizmetler
# ============================================================================
# SMS Service
SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.example.com/sms

# Payment Service
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_API_SECRET=your_payment_api_secret

# ============================================================================
# CACHE - Önbellek Ayarları
# ============================================================================
CACHE_DRIVER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# CORS - CORS Ayarları
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ============================================================================
# ACTUATOR - Spring Boot Actuator (Monitoring)
# ============================================================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# ============================================================================
# LIQUIBASE - Veritabanı Migrasyonu
# ============================================================================
LIQUIBASE_ENABLED=true
LIQUIBASE_CHANGELOG=classpath:db/changelog/db.changelog-master.yaml

# ============================================================================
# JPA/HIBERNATE - ORM Ayarları
# DDL_AUTO: update = Entity'lerden tabloları otomatik oluşturur/günceller
# SHOW_SQL: true = SQL sorgularını konsolda göster
# ============================================================================
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# ============================================================================
# SPRING AI - Gemini Konfigürasyonu
# ============================================================================
SPRING_AI_VERTEX_AI_GEMINI_PROJECT_ID=dummy-project-id
SPRING_AI_VERTEX_AI_GEMINI_LOCATION=us-central1
SPRING_AI_VERTEX_AI_GEMINI_CHAT_OPTIONS_MODEL=gemini-2.0-flash
SPRING_AI_VERTEX_AI_GEMINI_CHAT_OPTIONS_TEMPERATURE=0.5
