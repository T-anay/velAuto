# Velauto Backend - Environment Configuration Template
# Bunu .env dosyasına kopyalayıp gerekli değerleri doldurunuz

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_PORT=8090

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_URL=jdbc:mysql://localhost:3306/velauto?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=123
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ============================================
# JPA/HIBERNATE CONFIGURATION
# ============================================
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# ============================================
# LIQUIBASE CONFIGURATION
# ============================================
LIQUIBASE_ENABLED=true
LIQUIBASE_CHANGELOG=classpath:db/changelog/db.changelog-master.yaml

# ============================================
# SPRING AI - GEMINI CONFIGURATION
# ============================================
SPRING_AI_VERTEX_AI_GEMINI_PROJECT_ID=dummy-project-id
SPRING_AI_VERTEX_AI_GEMINI_LOCATION=us-central1
SPRING_AI_VERTEX_AI_GEMINI_CHAT_OPTIONS_MODEL=gemini-2.0-flash
SPRING_AI_VERTEX_AI_GEMINI_CHAT_OPTIONS_TEMPERATURE=0.5

# ============================================
# JWT SECURITY CONFIGURATION
# ============================================
JWT_SECRET=velAutoSecretKeyForJwtSecurityVelAutoSecretKeyForJwtSecurity
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

