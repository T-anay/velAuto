# Velauto Backend - Git Ignore Configuration

# Environment Files
.env
.env.local
.env.*.local

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.backup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.iml
*.iws
*.ipr
*.sublime-workspace
*.sublime-project

# JetBrains / IntelliJ specific files to ignore
# Ignore the entire .idea folder (workspace, caches, local history)
.idea/**
# Keep only shared IntelliJ settings if you want (uncomment if needed)
# !.idea/inspectionProfiles
# !.idea/codeStyles

